      <aliases enabled='yes' />
      <column caption='Churned Customer' datatype='string' name='[Calculation_0154532749348864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([end_date]) THEN&#13;&#10;    [customer_id]&#13;&#10;END' />
      </column>
      <column caption='Customers Using Feature' datatype='integer' name='[Calculation_0154532795207681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [feature_name] : COUNTD([customer_id]) }' />
      </column>
      <column caption='Feature Adoption Rate' datatype='real' name='[Calculation_0154532795826178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0154532795207681]&#13;&#10;/&#13;&#10;{ FIXED : COUNTD([customer_id]) }' />
      </column>
      <column caption='Customer Total Events' datatype='integer' name='[Calculation_0154532799500291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : COUNT([activity_id]) }' />
      </column>
      <column caption='Customer Avg Session' datatype='real' name='[Calculation_0154532800147460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : AVG([session_minutes]) }' />
      </column>
      <column caption='Customer Churn Status' datatype='string' name='[Calculation_0154532801515525]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([end_date]) THEN&#13;&#10;    &quot;Churned&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Active&quot;&#13;&#10;END' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_0154532806012935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [plan] : COUNTD([Calculation_0154532749348864]) }&#13;&#10;/&#13;&#10;{ FIXED [plan] : COUNTD([customer_id]) }' />
      </column>
      <column caption='Overall Churn Rate' datatype='real' name='[Calculation_0154532812566536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_0154532749348864])&#13;&#10;/&#13;&#10;COUNTD([customer_id])' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_0154532815151114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF ISNULL([end_date]) THEN&#13;&#10;        [customer_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Customer Engagement Level' datatype='string' name='[Calculation_1554211411132417]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0154532799500291] &gt;= 20 THEN&#13;&#10;    &quot;High&quot;&#13;&#10;ELSEIF [Calculation_0154532799500291] &gt;= 10 THEN&#13;&#10;    &quot;Medium&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column caption='Churn Rate by Engagement' datatype='real' name='[Calculation_1554211422593027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([end_date]) THEN&#13;&#10;        [customer_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([customer_id])' />
      </column>
      <column caption='Subscription Duration Months' datatype='integer' name='[Calculation_1554211475771396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;month&apos;,&#13;&#10;    [start_date],&#13;&#10;    IFNULL([end_date], DATE(&apos;2026-06-30&apos;))&#13;&#10;)' />
      </column>
      <column caption='High Engagement Retention' datatype='real' name='[Calculation_1554211475959813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_1554211411132417] = &quot;High&quot;&#13;&#10;    AND ISNULL([end_date])&#13;&#10;    THEN [customer_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;    IF [Calculation_1554211411132417] = &quot;High&quot;&#13;&#10;    THEN [customer_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Signup Cohort' datatype='datetime' name='[Calculation_1554211484471302]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [signup_date])' />
      </column>
      <column caption='Activity Month' datatype='datetime' name='[Calculation_1554211484569607]' role='dimension' type='ordinal'>
