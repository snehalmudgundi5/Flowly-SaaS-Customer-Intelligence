    <worksheet name='Signup Cohort'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000'>Customer Cohort Activity Retention</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='customers+' name='federated.186rmt7171jtv319xoaxd0jz2uva' />
          </datasources>
          <datasource-dependencies datasource='federated.186rmt7171jtv319xoaxd0jz2uva'>
            <column caption='Customer Total Events' datatype='integer' name='[Calculation_0154532799500291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [customer_id] : COUNT([activity_id]) }' />
            </column>
            <column caption='Customer Engagement Level' datatype='string' name='[Calculation_1554211411132417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0154532799500291] &gt;= 20 THEN&#13;&#10;    &quot;High&quot;&#13;&#10;ELSEIF [Calculation_0154532799500291] &gt;= 10 THEN&#13;&#10;    &quot;Medium&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low&quot;&#13;&#10;END' />
            </column>
            <column caption='Signup Cohort' datatype='datetime' name='[Calculation_1554211484471302]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [signup_date])' />
            </column>
            <column caption='Activity Month' datatype='datetime' name='[Calculation_1554211484569607]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [activity_date])' />
            </column>
            <column caption='Months Since Signup' datatype='integer' name='[Calculation_1554211484659720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;month&apos;,&#13;&#10;    [Calculation_1554211484471302],&#13;&#10;    [Calculation_1554211484569607]&#13;&#10;)' />
            </column>
            <column caption='Cohort Size' datatype='integer' name='[Calculation_1554211490541579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1554211484471302] : COUNTD([customer_id]) }' />
            </column>
            <column caption='Cohort Retention' datatype='real' name='[Calculation_1554211495108622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([customer_id])&#13;&#10;/&#13;&#10;MIN([Calculation_1554211490541579])' />
            </column>
            <column caption='Activity Date' datatype='date' name='[activity_date]' role='dimension' type='ordinal' />
            <column caption='Activity Id' datatype='string' name='[activity_id]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer Id' datatype='string' name='[customer_id]' role='dimension' type='nominal' />
            <column caption='Customer Segment' datatype='string' name='[customer_segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1554211484471302]' derivation='Month' name='[mn:Calculation_1554211484471302:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1554211411132417]' derivation='None' name='[none:Calculation_1554211411132417:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1554211484659720]' derivation='None' name='[none:Calculation_1554211484659720:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_segment]' derivation='None' name='[none:customer_segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[plan]' derivation='None' name='[none:plan:nk]' pivot='key' type='nominal' />
