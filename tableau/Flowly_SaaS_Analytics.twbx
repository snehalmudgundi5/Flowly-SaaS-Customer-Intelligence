          <datasources>
            <datasource caption='customers+' name='federated.186rmt7171jtv319xoaxd0jz2uva' />
          </datasources>
          <datasource-dependencies datasource='federated.186rmt7171jtv319xoaxd0jz2uva'>
            <column caption='Churned Customer' datatype='string' name='[Calculation_0154532749348864]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([end_date]) THEN&#13;&#10;    [customer_id]&#13;&#10;END' />
            </column>
            <column caption='Customer Total Events' datatype='integer' name='[Calculation_0154532799500291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [customer_id] : COUNT([activity_id]) }' />
            </column>
            <column caption='Overall Churn Rate' datatype='real' name='[Calculation_0154532812566536]' role='measure' type='quantitative'>
